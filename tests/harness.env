# Default settings of the channels test harness. Test-only values.
# To override a value, export it in your shell or put it in tests/.env (gitignored), which is read after this file.
JAHIA_VERSION=${JAHIA_VERSION:-8.2.3.2}
JAHIA_IMAGE=${JAHIA_IMAGE:-jahia/jahia-ee:${JAHIA_VERSION}}
MODULE_ID=${MODULE_ID:-channels}
MANIFEST=${MANIFEST:-provisioning-manifest-snapshot.yml}
JAHIA_PORT=${JAHIA_PORT:-8090}
JAHIA_DEBUG_PORT=${JAHIA_DEBUG_PORT:-8010}
JAHIA_URL=${JAHIA_URL:-http://localhost:${JAHIA_PORT}}
JAHIA_PROCESSING_URL=${JAHIA_PROCESSING_URL:-${JAHIA_URL}}
SUPER_USER_PASSWORD=${SUPER_USER_PASSWORD:-root1234}
